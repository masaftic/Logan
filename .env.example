# Logan - Environment Variables Template
# Copy this file to .env or configure secrets using `dotnet user-secrets`

# Stripe Sandbox Configuration (https://stripe.com)
STRIPE__SECRETKEY=sk_test_your_stripe_secret_key_here
STRIPE__PUBLISHABLEKEY=pk_test_your_stripe_publishable_key_here
STRIPE__WEBHOOKSECRET=whsec_your_stripe_webhook_secret_here

# Shippo Sandbox Configuration (https://goshippo.com)
SHIPPO__APIKEY=shippo_test_your_shippo_api_key_here
SHIPPO__WEBHOOKSECRET=your_shippo_webhook_secret_here

# Infrastructure Connections (defaults match docker-compose.yml)
CONNECTIONSTRINGS__DATABASE=Host=localhost;Port=5432;Database=orders_db;Username=postgres;Password=postgres
CONNECTIONSTRINGS__RABBITMQ=amqp://guest:guest@localhost:5672
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
