@Api_HostAddress = http://localhost:5242

### 1. Place a new order
# @name createOrder
POST {{Api_HostAddress}}/api/orders
Content-Type: application/json

{
  "amount": 149.99
}

### 2. Fetch order details (Status: Pending)
@orderId = {{createOrder.response.body.id}}
GET {{Api_HostAddress}}/api/orders/{{orderId}}
Accept: application/json

### 3. Create Payment Intent (Client-side checkout start)
# @name createIntent
POST {{Api_HostAddress}}/api/orders/{{orderId}}/pay
Content-Type: application/json

### 4. Simulate Payment Gateway Webhook (Payment Succeeded)
@txId = {{createIntent.response.body.paymentIntentId}}
POST {{Api_HostAddress}}/api/webhooks/payments
Content-Type: application/json

{
  "eventType": "payment_intent.succeeded",
  "orderId": "{{orderId}}",
  "gatewayTransactionId": "{{txId}}",
  "amount": 149.99
}

### 5. Fetch order details after Webhook (Status: Completed)
GET {{Api_HostAddress}}/api/orders/{{orderId}}
Accept: application/json

### 6. List all orders with payment history
GET {{Api_HostAddress}}/api/orders
Accept: application/json
